# Copy to .env and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare R2 bucket and S3-compatible credentials. Keep access keys server-only.
CLOUDFLARE_R2_BUCKET_NAME=your-r2-bucket-name
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# One-time migration credentials. List exactly three source bucket names.
SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=your-supabase-storage-region
SUPABASE_S3_ACCESS_KEY_ID=your-supabase-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key
SUPABASE_BUCKET_NAMES=avatars,posts,media

# Server-only keys for Paystack verification. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key
OPENAI_API_KEY=your-server-only-openai-api-key
GOOGLE_CSE_API_KEY=your-server-only-google-custom-search-api-key
GOOGLE_CSE_ID=your-programmable-search-engine-id

# Video moderation uses the bundled local FFmpeg and FFprobe binaries.
